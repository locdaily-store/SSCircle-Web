{
  "name": "sscircle-local-development",
  "version": "10.51.4",
  "private": true,
  "description": "SSCircle Pages Advanced Mode local development with isolated D1 fixtures",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/local-dev.mjs dev",
    "local:init": "node scripts/local-dev.mjs init",
    "local:check": "node scripts/local-dev.mjs check",
    "build:local": "node scripts/build-local.mjs",
    "test:local": "node --test tests/local-dev.test.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
